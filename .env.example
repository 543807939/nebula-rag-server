# 复制为 .env 后按需修改：cp .env.example .env

# SQLite 连接串。
# 注意：相对路径是相对 schema 所在的 prisma/ 目录解析的，
# 所以 file:./dev.db 实际落在 prisma/dev.db
DATABASE_URL="file:./dev.db"

PORT=3000

# 生产环境请替换为足够随机的长字符串
JWT_ACCESS_SECRET="replace-with-a-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret"

# 大模型调用参数
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"   # 智谱
LLM_API_KEY="<key>"
LLM_CHAT_MODEL="GLM-5.3-Flash"
LLM_EMBEDDING_MODEL="embedding-3"
LLM_EMBEDDING_DIMENSIONS=2048  
LLM_TEMPERATURE=0.7  # 采样温度  范围[0-1]之间 两位小数  越大模型创造性和随机性更强   越小模型更保守和可信 基于文档回答 不需要很大